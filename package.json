    "build": "tsc -p tsconfig.json && npm run build:client"
  },
  "dependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^20.11.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "tsx": "^4.23.15",
    "typescript": "^5.4.5"
  }
}
