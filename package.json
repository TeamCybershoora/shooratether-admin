{
  "name": "shooratether-admin",
  "version": "1.0.0",
  "description": "SHOORA TETHER Enterprise Admin & User Management Portal",
  "main": "src/server.ts",
  "type": "module",
  "scripts": {
    "start": "tsx src/server.ts",
    "start:dist": "node dist/server.js",
